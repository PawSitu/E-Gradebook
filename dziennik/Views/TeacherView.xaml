<UserControl x:Class="dziennik.Views.TeacherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:dziennik.Views"
             xmlns:converters="clr-namespace:dziennik.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <converters:BooleanToStringConverter x:Key="BooleanToStringConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{Binding FullName}" FontSize="24" FontWeight="Bold"/>
                <TextBlock Text="Teacher" FontSize="16" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Content="Logout" Command="{Binding LogoutCommand}" 
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,0,0,0" Padding="10,5"
                    Height="32"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" 
                   Foreground="Red" FontWeight="Bold" Margin="0,0,0,10"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Subject:" VerticalAlignment="Center"/>
            <ComboBox Width="200" Margin="10,0,0,0" DisplayMemberPath="Name"
                      ItemsSource="{Binding AssignedSubjects}"
                      SelectedItem="{Binding SelectedSubject}"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Select class:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding TeacherClasses}" DisplayMemberPath="Name"
                              SelectedItem="{Binding SelectedClass}"/>
                    <Button Content="Load students" Margin="0,5,0,0" Padding="5,2"
                            Command="{Binding LoadStudentsCommand}"
                            CommandParameter="{Binding SelectedClass}"/>
                </StackPanel>

                <ListView Grid.Row="1" Margin="0,10,0,0"
                          ItemsSource="{Binding ClassStudents}"
                          SelectedItem="{Binding SelectedStudent}">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0} {1}">
                                        <Binding Path="Person.FirstName"/>
                                        <Binding Path="Person.LastName"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <TabControl Grid.Column="1" Margin="10,0,0,0">
                <TabItem Header="Grades">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="81*"/>
                            <ColumnDefinition Width="463*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10,0,10" Grid.ColumnSpan="2">
                            <TextBlock Text="{Binding EditMode, Converter={StaticResource BooleanToStringConverter}, ConverterParameter='Edit grade:;Add grade:'}" VerticalAlignment="Center"/>
                            <ComboBox Width="50" Margin="10,0,0,0"
                                      SelectedValuePath="Content"
                                      SelectedValue="{Binding NewGradeValue}">
                                <ComboBoxItem Content="1"/>
                                <ComboBoxItem Content="1.5"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="2.5"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="3.5"/>
                                <ComboBoxItem Content="4"/>
                                <ComboBoxItem Content="4.5"/>
                                <ComboBoxItem Content="5"/>
                                <ComboBoxItem Content="5.5"/>
                                <ComboBoxItem Content="6"/>
                            </ComboBox>
                            <Button Content="Add" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding AddGradeCommand}"
                                    Visibility="{Binding EditMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                            <Button Content="Save" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding EditGradeCommand}"
                                    Visibility="{Binding EditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Content="Cancel" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding CancelEditCommand}"
                                    Visibility="{Binding EditMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding StudentGrades}" 
                                  SelectedItem="{Binding SelectedGrade}" Grid.ColumnSpan="2">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Grade" Width="50">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Value}" FontWeight="Bold"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Issue Date" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding IssueDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Actions" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Delete" Padding="10,0"
                                                        Command="{Binding DataContext.DeleteGradeCommand, 
                                                        RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="Attendance">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,10">
                            <TextBlock Text="Attendance status:" VerticalAlignment="Center"/>
                            <ComboBox Width="120" Margin="10,0,0,0"
                                      SelectedValuePath="Tag"
                                      SelectedValue="{Binding NewAttendanceStatus}">
                                <ComboBoxItem Content="Present" Tag="1"/>
                                <ComboBoxItem Content="Absent" Tag="2"/>
                                <ComboBoxItem Content="Late" Tag="3"/>
                            </ComboBox>
                            <Button Content="Add" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding AddAttendanceCommand}"/>
                            <Button Content="Edit" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding EditAttendanceCommand}"/>
                            <Button Content="Delete" Margin="10,0,0,0" Padding="10,0"
                                    Command="{Binding DeleteAttendanceCommand}"/>
                        </StackPanel>

                        <ListView Grid.Row="1" ItemsSource="{Binding StudentAttendances}" SelectedItem="{Binding SelectedAttendance}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Date" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Date, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Status" Width="100">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="1">
                                                                    <Setter Property="Text" Value="Present"/>
                                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="2">
                                                                    <Setter Property="Text" Value="Absent"/>
                                                                    <Setter Property="Foreground" Value="#F44336"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="3">
                                                                    <Setter Property="Text" Value="Late"/>
                                                                    <Setter Property="Foreground" Value="#FFC107"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>
                </TabItem>

                <TabItem Header="Statistics">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,10,0,10" 
                                    Visibility="{Binding ShowAttendance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Student: " FontWeight="Bold"/>
                                <TextBlock>
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} {1}">
                                            <Binding Path="SelectedStudent.Person.FirstName"/>
                                            <Binding Path="SelectedStudent.Person.LastName"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                <TextBlock Text="Subject: " FontWeight="Bold"/>
                                <TextBlock Text="{Binding SelectedSubject.Name}"/>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Row="1" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="0,0,0,10" Margin="0,0,0,10"
                                Visibility="{Binding ShowAttendance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Grade Statistics" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Average Grade:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SubjectAverage, StringFormat='{}{0:0.00}'}" 
                                                   Foreground="#1976D2" FontSize="18" Margin="0,5,0,0"/>    
                                    </StackPanel>
                                    <StackPanel Margin="40,0,0,0">
                                        <TextBlock Text="Final Grade:" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding FinalGrade}" 
                                                   Foreground="#1976D2" FontSize="18" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2" 
                              Visibility="{Binding ShowAttendance, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Attendance Statistics" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

                            <Grid Grid.Row="1" Margin="10,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal">
                                    <TextBlock Text="Attendance:" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SubjectAttendancePercent, StringFormat=' {0}%'}" 
                                               Foreground="#1976D2" FontWeight="Bold"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Text="{Binding SubjectAttendanceDetails}" 
                                           Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </Grid>
                        </Grid>

                        <TextBlock Grid.Row="0" Grid.RowSpan="3" 
                                   Text="Select a student to view their statistics" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                   Visibility="{Binding ShowAttendance, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
